{
  "manifest_version": 3,
  "name": "Milan Magar Filler",
  "version": "1.0",
  "description": "Choose a region, then click any text box to fill it with 'Milan Magar'.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}